{
  "name": "mission-control-claude-plugin",
  "version": "0.0.0",
  "private": true,
  "description": "Build and test tooling for the mission-control Claude Code plugin",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit",
    "lint": "ultracite check",
    "fix": "ultracite fix",
    "test": "rstest run",
    "vendor": "node scripts/vendor-upstream.ts",
    "check": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "devDependencies": {
    "@rslib/core": "1.0.4",
    "@rstest/core": "0.12.4",
    "@types/node": "24.19.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "6.0.3",
    "ultracite": "8.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
