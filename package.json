  },
  "devDependencies": {
    "@rslib/core": "1.0.4",
    "@rstest/core": "0.12.4",
    "@types/node": "24.19.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "6.0.3",
    "ultracite": "8.1.0"
  },
  "engines": {
    "node": ">=18"
  }
